{
  "schema": "verify-scenario/1",
  "feature": "agent-gates-end-to-end",
  "steps": [
    {
      "name": "status-ready",
      "argv": ["status", "--json"],
      "expect": {
        "exitCode": 0,
        "stderr": "",
        "result": {
          "commandIdentity": "agent-gates.status",
          "causeCode": "SUCCESS_UNCHANGED",
          "data.ready": true
        }
      }
    },
    {
      "name": "pending-empty",
      "argv": ["pending", "--json"],
      "expect": {
        "exitCode": 0,
        "stderr": "",
        "result": {
          "commandIdentity": "agent-gates.pending",
          "causeCode": "SUCCESS_UNCHANGED",
          "data.unfinished.length": 0
        }
      }
    },
    {
      "name": "init-scratch-git-repo",
      "runner": "bun",
      "argv": [
        "-e",
        "import { mkdirSync, writeFileSync } from 'node:fs'; import { join } from 'node:path'; const r = join(process.argv[1], 'repo'); mkdirSync(join(r, 'src'), { recursive: true }); mkdirSync(join(r, 'change-notes'), { recursive: true }); writeFileSync(join(r, 'agent-gates.json'), JSON.stringify({ changeNotes: { folder: 'change-notes', shippedFiles: ['package.json'], shippedFolders: ['src'], affects: ['cli'] }, versions: { folder: 'versions', heading: 'Repository version' } }, null, 2)); writeFileSync(join(r, 'src/app.ts'), 'export const v = 1;\\n'); writeFileSync(join(r, 'change-notes/README.md'), '# Notes\\n'); const env = { ...process.env, GIT_AUTHOR_NAME: 'Verify', GIT_AUTHOR_EMAIL: 'v@example.test', GIT_COMMITTER_NAME: 'Verify', GIT_COMMITTER_EMAIL: 'v@example.test', GIT_CONFIG_GLOBAL: '/dev/null', GIT_CONFIG_NOSYSTEM: '1' }; for (const k of ['GIT_DIR', 'GIT_WORK_TREE', 'GIT_INDEX_FILE', 'GIT_OBJECT_DIRECTORY', 'GIT_ALTERNATE_OBJECT_DIRECTORIES', 'GIT_COMMON_DIR']) delete env[k]; const g = (...a) => { const x = Bun.spawnSync(['git', ...a], { cwd: r, env }); if (x.exitCode !== 0) throw new Error(x.stderr.toString()); }; g('init', '-q', '-b', 'main'); g('add', 'agent-gates.json', 'src/app.ts', 'change-notes/README.md'); g('commit', '-q', '-m', 'init'); g('checkout', '-q', '-b', 'feat'); writeFileSync(join(r, 'src/app.ts'), 'export const v = 2;\\n'); g('add', 'src/app.ts'); g('commit', '-q', '-m', 'shipped edit'); console.log('READY');",
        "{scratch}"
      ],
      "expect": {
        "exitCode": 0,
        "stdoutIncludes": ["READY"]
      }
    },
    {
      "name": "change-note-check-refuses-missing-note",
      "argv": [
        "change-note",
        "check",
        "--base",
        "main",
        "--repository",
        "{scratch}/repo",
        "--json"
      ],
      "expect": {
        "exitCode": 3,
        "stderr": "",
        "result": {
          "commandIdentity": "agent-gates.change-note-check",
          "causeCode": "DOMAIN_GATES_NOTE_MISSING"
        }
      }
    },
    {
      "name": "change-note-add-refuses-breaking-without-action",
      "argv": [
        "change-note",
        "add",
        "--slug",
        "bad-break",
        "--kind",
        "removed",
        "--breaking",
        "--affects",
        "cli",
        "--summary",
        "Dropped old option.",
        "--date",
        "2026-11-22",
        "--repository",
        "{scratch}/repo",
        "--json"
      ],
      "expect": {
        "exitCode": 3,
        "stderr": "",
        "result": {
          "commandIdentity": "agent-gates.change-note-add",
          "causeCode": "DOMAIN_GATES_NOTE_INVALID"
        }
      }
    },
    {
      "name": "change-note-add-succeeds",
      "argv": [
        "change-note",
        "add",
        "--slug",
        "bump-value",
        "--kind",
        "changed",
        "--breaking",
        "--affects",
        "cli",
        "--summary",
        "Changed exported value from 1 to 2.",
        "--action",
        "Update callers expecting value 1 to accept 2.",
        "--date",
        "2026-11-22",
        "--repository",
        "{scratch}/repo",
        "--json"
      ],
      "expect": {
        "exitCode": 0,
        "stderr": "",
        "result": {
          "commandIdentity": "agent-gates.change-note-add",
          "causeCode": "SUCCESS_COMPLETED",
          "data.relativePath": "change-notes/2026-11-22-bump-value.json"
        }
      }
    },
    {
      "name": "change-note-add-refuses-duplicate",
      "argv": [
        "change-note",
        "add",
        "--slug",
        "bump-value",
        "--kind",
        "fixed",
        "--affects",
        "cli",
        "--summary",
        "Duplicate slug.",
        "--date",
        "2026-11-22",
        "--repository",
        "{scratch}/repo",
        "--json"
      ],
      "expect": {
        "exitCode": 3,
        "stderr": "",
        "result": {
          "commandIdentity": "agent-gates.change-note-add",
          "causeCode": "DOMAIN_GATES_FILE_EXISTS"
        }
      }
    },
    {
      "name": "commit-written-note",
      "runner": "bun",
      "argv": [
        "-e",
        "import { join } from 'node:path'; const r = join(process.argv[1], 'repo'); const env = { ...process.env, GIT_AUTHOR_NAME: 'Verify', GIT_AUTHOR_EMAIL: 'v@example.test', GIT_COMMITTER_NAME: 'Verify', GIT_COMMITTER_EMAIL: 'v@example.test', GIT_CONFIG_GLOBAL: '/dev/null', GIT_CONFIG_NOSYSTEM: '1' }; for (const k of ['GIT_DIR', 'GIT_WORK_TREE', 'GIT_INDEX_FILE', 'GIT_OBJECT_DIRECTORY', 'GIT_ALTERNATE_OBJECT_DIRECTORIES', 'GIT_COMMON_DIR']) delete env[k]; const g = (...a) => { const x = Bun.spawnSync(['git', ...a], { cwd: r, env }); if (x.exitCode !== 0) throw new Error(x.stderr.toString()); }; g('add', 'change-notes/2026-11-22-bump-value.json'); g('commit', '-q', '-m', 'add note'); console.log('COMMITTED');",
        "{scratch}"
      ],
      "expect": {
        "exitCode": 0,
        "stdoutIncludes": ["COMMITTED"]
      }
    },
    {
      "name": "change-note-check-passes-after-commit",
      "argv": [
        "change-note",
        "check",
        "--base",
        "main",
        "--repository",
        "{scratch}/repo",
        "--json"
      ],
      "expect": {
        "exitCode": 0,
        "stderr": "",
        "result": {
          "commandIdentity": "agent-gates.change-note-check",
          "causeCode": "SUCCESS_UNCHANGED",
          "data.addedNotes.0": "change-notes/2026-11-22-bump-value.json"
        }
      }
    },
    {
      "name": "version-preview-renders-without-writing",
      "argv": [
        "version",
        "preview",
        "--lead",
        "Exported value updated to 2.",
        "--date",
        "2026-11-22",
        "--repository",
        "{scratch}/repo",
        "--json"
      ],
      "expect": {
        "exitCode": 0,
        "stderr": "",
        "result": {
          "commandIdentity": "agent-gates.version-preview",
          "causeCode": "SUCCESS_UNCHANGED",
          "data.version": "0.1.0",
          "data.written": false
        }
      }
    },
    {
      "name": "version-prepare-writes-first-0-1-0-account",
      "argv": [
        "version",
        "prepare",
        "--lead",
        "Exported value updated to 2.",
        "--date",
        "2026-11-22",
        "--repository",
        "{scratch}/repo",
        "--json"
      ],
      "expect": {
        "exitCode": 0,
        "stderr": "",
        "result": {
          "commandIdentity": "agent-gates.version-prepare",
          "causeCode": "SUCCESS_COMPLETED",
          "data.version": "0.1.0",
          "data.relativePath": "versions/v0.1.0.md",
          "data.written": true
        }
      }
    },
    {
      "name": "version-prepare-refuses-overwrite",
      "argv": [
        "version",
        "prepare",
        "--lead",
        "Duplicate.",
        "--date",
        "2026-11-22",
        "--repository",
        "{scratch}/repo",
        "--json"
      ],
      "expect": {
        "exitCode": 3,
        "stderr": "",
        "result": {
          "commandIdentity": "agent-gates.version-prepare",
          "causeCode": "DOMAIN_GATES_FILE_EXISTS"
        }
      }
    }
  ]
}
